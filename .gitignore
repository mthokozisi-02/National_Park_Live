# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Trained wildlife model weights
backend/models/*.pt

# Generated detection videos
backend/output/*
!backend/output/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python & virtual environments
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.pyd
*.egg-info/
.pytest_cache/

# Machine learning model weights & processed videos
*.pt
*.pth
*.onnx
backend/output/
backend/videos/
training/runs/
datasets/african_wildlife/images/
datasets/african_wildlife/labels/
datasets/african_wildlife/extracted_raw/
