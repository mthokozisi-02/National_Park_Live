# SafariVision Backend Environment Configuration

# YOLO model checkpoint path (defaults to backend/models/best_finetuned.pt)
# Set to an absolute path or relative path to your fine-tuned weights:
MODEL_PATH=models/best_finetuned.pt
# Alternatively:
# YOLO_MODEL_PATH=models/best_finetuned.pt

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Upload limits (in bytes, 100MB = 104857600)
MAX_UPLOAD_BYTES=104857600
